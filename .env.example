# GRID environment variables

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (weekly digest emails)
RESEND_API_KEY=
RESEND_FROM="GRID <digest@yourdomain.com>"

# Digest secret (min 32 chars random)
DIGEST_SECRET=

# Comma-separated test emails for digest
DIGEST_TEST_EMAILS=

# Stripe (when you add real checkout)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
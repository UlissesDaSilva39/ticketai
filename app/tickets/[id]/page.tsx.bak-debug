import Link from "next/link";
import { notFound, redirect } from "next/navigation";
import type { Metadata } from "next";
import { createServerSupabase } from "@/lib/supabase/server";
import { Sidebar } from "@/components/sidebar/Sidebar";
import TicketQR from "@/components/tickets/TicketQR";

export const dynamic = "force-dynamic";

export const metadata: Metadata = {
  title: "Ticket",
  description: "Your GRID ticket.",
};

type Props = { params: Promise<{ id: string }> };

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

type TicketRow = {
  id: string;
  user_id: string;
  event_id: string;
  status: string | null;
  created_at: string;
  qr_token: string | null;
  checked_in_at: string | null;
  tier_name: string | null;
  price_pence: number | null;
};

type EventRow = {
  id: string;
  title: string;
  start_date: string;
  end_date: string | null;
  hero_image: string | null;
  venue_id: string | null;
  status: string | null;
};

type VenueRow = {
  id: string;
  name: string | null;
  city: string | null;
  address: string | null;
};

export default async function TicketDetailPage({ params }: Props) {
  const { id } = await params;
  if (!UUID_RE.test(id)) notFound();

  const supabase = await createServerSupabase();
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) redirect("/login?next=/tickets/" + id);

  const { data: ticket } = await supabase
    .from("tickets")
    .select("*")
    .eq("id", id)
    .maybeSingle();

  if (!ticket) notFound();
  const t = ticket as TicketRow;

  // Only the owner can view
  if (t.user_id !== user.id) {
    return (
      <div className="bg-gray-50 min-h-screen pb-32">
        <div className="mx-auto max-w-[1400px] px-6 py-6 grid grid-cols-12 gap-6">
          <div className="col-span-12 lg:col-span-3"><Sidebar /></div>
          <main className="col-span-12 lg:col-span-9 min-w-0">
            <div className="rounded-2xl border border-gray-200 bg-white p-12 text-center">
              <p className="text-gray-900 font-medium mb-1">Not your ticket</p>
              <p className="text-gray-600 text-sm mb-4">
                Only the ticket owner can view this page.
              </p>
              <Link href="/my-tickets" className="inline-block rounded-full bg-black text-white text-sm font-semibold px-6 py-2 hover:bg-gray-800">
                Back to My Tickets
              </Link>
            </div>
          </main>
        </div>
      </div>
    );
  }

  // Fetch event
  const { data: eventRow } = await supabase
    .from("events")
    .select("id, title, start_date, end_date, hero_image, venue_id, status")
    .eq("id", t.event_id)
    .maybeSingle();

  const event = (eventRow as EventRow) || null;

  // Fetch venue
  let venue: VenueRow | null = null;
  if (event?.venue_id) {
    const { data: v } = await supabase
      .from("venues")
      .select("id, name, city, address")
      .eq("id", event.venue_id)
      .maybeSingle();
    venue = (v as VenueRow) || null;
  }

  const start = event?.start_date ? new Date(event.start_date) : null;
  const dateStr = start
    ? start.toLocaleDateString("en-GB", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      })
    : "";
  const timeStr = start
    ? start.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })
    : "";

  const isReturned = t.status === "returned";
  const isCheckedIn = !!t.checked_in_at;
  const qrValue = "GRID-TICKET:" + t.id + ":" + (t.qr_token || t.id);

  return (
    <div className="bg-gray-50 min-h-screen pb-32">
      <div className="mx-auto max-w-[1400px] px-6 py-6 grid grid-cols-12 gap-6">
        <div className="col-span-12 lg:col-span-3"><Sidebar /></div>

        <main className="col-span-12 lg:col-span-9 min-w-0">
          <nav className="mb-4 text-xs text-gray-500">
            <Link href="/my-tickets" className="hover:text-black">My Tickets</Link>
            <span className="mx-2">/</span>
            <span className="text-gray-800">{event?.title || "Ticket"}</span>
          </nav>

          <div className="bg-white border border-gray-200 rounded-2xl overflow-hidden">
            {/* Header strip */}
            <div className="bg-gradient-to-br from-gray-900 via-gray-900 to-black text-white p-6">
              <div className="flex flex-wrap items-start justify-between gap-4">
                <div className="min-w-0">
                  <p className="text-xs uppercase tracking-[0.3em] text-white/50 mb-2">
                    {isReturned ? "RETURNED" : isCheckedIn ? "CHECKED IN" : "ADMIT ONE"}
                  </p>
                  <h1
                    className="text-3xl md:text-4xl font-bold uppercase leading-tight truncate"
                    style={{ fontFamily: "var(--font-antonio)" }}
                  >
                    {event?.title || "Event"}
                  </h1>
                  <p className="text-white/70 mt-2 text-sm">
                    {dateStr}{timeStr ? " · " + timeStr : ""}
                  </p>
                  {venue ? (
                    <p className="text-white/50 text-sm mt-1">
                      {venue.name}{venue.city ? " · " + venue.city : ""}
                    </p>
                  ) : null}
                </div>

                <div className="text-right shrink-0">
                  {isReturned ? (
                    <span className="inline-block rounded-full bg-red-500/20 border border-red-400/40 text-red-200 text-xs font-bold uppercase tracking-wider px-3 py-1.5">
                      Returned
                    </span>
                  ) : isCheckedIn ? (
                    <span className="inline-block rounded-full bg-blue-500/20 border border-blue-400/40 text-blue-200 text-xs font-bold uppercase tracking-wider px-3 py-1.5">
                      Checked in
                    </span>
                  ) : (
                    <span className="inline-block rounded-full bg-green-500/20 border border-green-400/40 text-green-200 text-xs font-bold uppercase tracking-wider px-3 py-1.5">
                      Valid
                    </span>
                  )}
                </div>
              </div>
            </div>

            {/* Body: QR on left, details on right */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-8 p-6 md:p-8">
              <div className="flex flex-col items-center justify-center">
                <TicketQR value={qrValue} size={260} />
                <p className="text-xs text-gray-500 mt-3 text-center max-w-xs">
                  Show this at the door. Each QR is unique to this ticket.
                </p>
                <p className="text-[10px] font-mono text-gray-400 mt-1 break-all text-center max-w-xs">
                  {t.id.slice(0, 8)} · {t.qr_token ? t.qr_token.slice(0, 12) : "no-token"}
                </p>
              </div>

              <div className="flex flex-col">
                <h2
                  className="text-lg font-bold uppercase mb-3"
                  style={{ fontFamily: "var(--font-antonio)" }}
                >
                  Ticket details
                </h2>

                <dl className="divide-y divide-gray-100 text-sm">
                  <div className="flex justify-between py-2.5">
                    <dt className="text-gray-500">Event</dt>
                    <dd className="font-semibold text-right">{event?.title || "—"}</dd>
                  </div>
                  <div className="flex justify-between py-2.5">
                    <dt className="text-gray-500">Date</dt>
                    <dd className="font-semibold text-right">{dateStr || "—"}</dd>
                  </div>
                  <div className="flex justify-between py-2.5">
                    <dt className="text-gray-500">Time</dt>
                    <dd className="font-semibold text-right">{timeStr || "—"}</dd>
                  </div>
                  {venue ? (
                    <>
                      <div className="flex justify-between py-2.5">
                        <dt className="text-gray-500">Venue</dt>
                        <dd className="font-semibold text-right">{venue.name || "—"}</dd>
                      </div>
                      {venue.address ? (
                        <div className="flex justify-between py-2.5">
                          <dt className="text-gray-500">Address</dt>
                          <dd className="font-semibold text-right max-w-[60%]">{venue.address}</dd>
                        </div>
                      ) : null}
                    </>
                  ) : null}
                  {t.tier_name ? (
                    <div className="flex justify-between py-2.5">
                      <dt className="text-gray-500">Ticket type</dt>
                      <dd className="font-semibold text-right">{t.tier_name}</dd>
                    </div>
                  ) : null}
                  {typeof t.price_pence === "number" ? (
                    <div className="flex justify-between py-2.5">
                      <dt className="text-gray-500">Paid</dt>
                      <dd className="font-semibold text-right">
                        £{(t.price_pence / 100).toFixed(2)}
                      </dd>
                    </div>
                  ) : null}
                  <div className="flex justify-between py-2.5">
                    <dt className="text-gray-500">Purchased</dt>
                    <dd className="font-semibold text-right">
                      {new Date(t.created_at).toLocaleDateString("en-GB")}
                    </dd>
                  </div>
                  <div className="flex justify-between py-2.5">
                    <dt className="text-gray-500">Ticket ID</dt>
                    <dd className="font-mono text-xs text-right">{t.id.slice(0, 12)}</dd>
                  </div>
                </dl>

                {!isReturned && !isCheckedIn ? (
                  <div className="mt-6 flex flex-wrap gap-3">
                    <a
                      href={event ? "/event/" + event.id : "#"}
                      className="rounded-full bg-black text-white text-sm font-semibold px-5 py-2 hover:bg-gray-800"
                    >
                      View event
                    </a>
                    <button
                      type="button"
                      className="rounded-full border border-gray-300 text-gray-800 text-sm font-semibold px-5 py-2 hover:border-gray-400"
                      // download via browser — no server action needed
                    >
                      Save as image
                    </button>
                  </div>
                ) : null}

                {isReturned ? (
                  <div className="mt-6 rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700">
                    This ticket was returned. It can no longer be used for entry.
                  </div>
                ) : null}

                {isCheckedIn ? (
                  <div className="mt-6 rounded-lg border border-blue-200 bg-blue-50 p-3 text-xs text-blue-700">
                    This ticket was already scanned on{" "}
                    {new Date(t.checked_in_at!).toLocaleString("en-GB")}.
                  </div>
                ) : null}
              </div>
            </div>
          </div>

          <div className="mt-6 text-center">
            <Link href="/my-tickets" className="text-sm underline text-gray-600 hover:text-black">
              ← Back to My Tickets
            </Link>
          </div>
        </main>
      </div>
    </div>
  );
}
@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #101114;
  --brand: #4f46e5;
  --border: #e8e8eb;
  --bg-soft: #f7f7f8;
  --text-soft: #5b6068;
  --text-mute: #8a8f98;
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

a:hover {
  color: var(--brand);
}

button {
  font: inherit;
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

/* ── Dark-background buttons and links ──
   Any element with .text-white must override the global a { color: blue } rule */
a.text-white,
a.text-white:link,
a.text-white:visited,
a.text-white:hover,
a.text-white:focus,
button.text-white,
button.text-white:hover {
  color: #ffffff !important;
}
/* =========================================
   MOBILE FIX: Hide Sidebar & Expand Content
   ========================================= */
@media (max-width: 768px) {
  /* Hide the sidebar (assuming it uses <aside> or a specific class) */
  aside, 
  .sidebar, 
  [class*="sidebar"] {
    display: none !important;
  }

  /* Remove the left margin from the main content so it takes 100% width */
  main, 
  .main-content,
  [class*="main-content"] {
    margin-left: 0 !important;
    width: 100% !important;
    padding-left: 0 !important;
  }

  /* Make the top navbar sticky so users can still navigate */
  header, nav {
    position: sticky !important;
    top: 0 !important;
    width: 100% !important;
    z-index: 50 !important;
    background-color: white !important;
    border-bottom: 1px solid #e5e7eb !important;
  }
}

.hide-scrollbar::-webkit-scrollbar { display: none; } .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
